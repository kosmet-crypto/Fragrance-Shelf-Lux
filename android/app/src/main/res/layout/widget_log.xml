<?xml version="1.0" encoding="utf-8"?>
<!-- 2 x 2: today's pick as a picture, a Wear button (one tap) and + (open the wear log). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <ImageView
        android:id="@+id/w_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="40dp"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher_foreground" />

    <TextView
        android:id="@+id/w_done"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:text="✓"
        android:textColor="#19130A"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_wear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:text="Wear"
            android:textColor="#19130A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_other"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:background="@drawable/widget_btn_ghost"
            android:gravity="center"
            android:text="+"
            android:textColor="#F5F0E4"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
